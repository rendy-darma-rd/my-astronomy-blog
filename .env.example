# Keystatic GitHub Configuration
# Required for production use of Keystatic with GitHub storage

# Your GitHub username or organization
KEYSTATIC_GITHUB_OWNER=your-github-username

# Your GitHub repository name
KEYSTATIC_GITHUB_REPO=my-astronomy-blog

# Set to 'true' to use GitHub mode in local development (optional)
# By default, local development uses local file storage
# KEYSTATIC_GITHUB_MODE=false

# GitHub OAuth App credentials (required for production)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: https://yourdomain.com/api/keystatic/github/oauth/callback
PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=your_github_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Personal Access Token (alternative to OAuth for simpler setup)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
# KEYSTATIC_GITHUB_TOKEN=your_github_personal_access_token
