---
export const prerender = true;

import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Load all images from content folders
const images = import.meta.glob<{ default: ImageMetadata }>('/src/content/artikel/**/*.{jpg,jpeg,png,gif,webp}', { eager: true });

function getImageSrc(post: any) {
	if (!post.data.heroImage) return null;
	const imagePath = `/src/content/artikel/${post.id}/${post.data.heroImage}`;
	const imageModule = images[imagePath];
	return imageModule ? imageModule.default : null;
}

const heroImageSrc = getImageSrc(post);
---

<BlogPost {...post.data} heroImage={heroImageSrc}>
	<Content />
</BlogPost>
