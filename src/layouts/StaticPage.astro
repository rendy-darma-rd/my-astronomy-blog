---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import MonetagVignetteBannerTag from '../components/MonetagVignetteBanner.astro';
import MonetagPushNotifTag from '../components/MonetagPushNotif.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
	title: string;
	description: string;
	breadcrumbLabel: string;
	titlePrefix: string;
	titleAccent: string;
	subtitle: string;
	eyebrow?: string;
}

const {
	title,
	description,
	breadcrumbLabel,
	titlePrefix,
	titleAccent,
	subtitle,
	eyebrow = '✦ Explore the universe',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
		<GoogleAnalytics />
		<MonetagPushNotifTag />
		<MonetagVignetteBannerTag />
	</head>
	<body>
		<Header />

		<main>
		<div class="page-wrapper">
			<!-- PAGE HEADER -->
			<div class="page-header">
				<Breadcrumb items={[
					{ label: 'Beranda', href: '/' },
					{ label: breadcrumbLabel },
				]} />
				<div class="page-eyebrow">{eyebrow}</div>
				<h1 class="page-title">{titlePrefix} <span>{titleAccent}</span></h1>
				<p class="page-sub">{subtitle}</p>
			</div>

			<!-- CONTENT -->
			<div class="static-content">
				<slot />
			</div>
		</div>
		</main>

		<Footer />
		<BackToTop />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Nunito:wght@300;400;500;600;700&display=swap');

	.page-wrapper {
		font-family: 'Nunito', sans-serif;
		background: #f5f3ef;
		min-height: 100vh;
		overflow-x: hidden;
	}

	.page-header {
		position: relative;
		z-index: 5;
		background: linear-gradient(180deg, #eceae4 0%, #f5f3ef 100%);
		border-bottom: 1px solid #e2ddd6;
		padding: 2rem 2rem 1.5rem;
		text-align: center;
	}

	.page-eyebrow {
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #6e5f52;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.page-title {
		font-family: 'Lora', serif;
		font-size: 40px;
		font-weight: 600;
		color: #2a2420;
		margin-bottom: 0.4rem;
	}

	.page-title span {
		color: #4a6fa5;
		font-style: italic;
	}

	.page-sub {
		font-size: 16px;
		color: #6e5f52;
		font-weight: 400;
	}

	.static-content {
		max-width: 1300px;
		margin: 0 auto;
		padding: 2rem 2rem 3rem;
	}

	.static-intro {
		font-size: 20px;
		font-weight: 500;
		color: #5a5040;
		line-height: 1.8;
		margin-bottom: 1.5rem;
	}

	.static-section {
		margin-bottom: 3rem;
	}

	.static-section p {
		font-size: 18px;
		line-height: 1.75;
		color: #6a6050;
		margin-bottom: 1.2rem;
	}

	.static-section ul,
	.static-section ol {
		margin: 0 0 1.2rem 1.4rem;
		padding: 0;
	}

	.static-section li {
		font-size: 18px;
		line-height: 1.75;
		color: #6a6050;
		margin-bottom: 0.6rem;
	}

	.static-section a {
		color: #4a6fa5;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.static-heading {
		font-family: 'Lora', serif;
		font-size: 26px;
		font-weight: 600;
		color: #2a2420;
		margin-bottom: 1rem;
		margin-top: 0;
	}

	.static-footer {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid #e2ddd6;
		text-align: center;
	}

	.static-tagline {
		font-size: 16px;
		color: #4a4034;
		line-height: 1.8;
		margin: 0;
	}

	.static-tagline strong {
		font-family: 'Lora', serif;
		font-size: 22px;
		color: #2a2420;
	}

	.static-tagline em {
		color: #4a6fa5;
	}

	@media (max-width: 768px) {
		.page-header {
			padding: 1.5rem 1rem 1rem;
		}

		.page-title {
			font-size: 32px;
		}

		.page-sub {
			font-size: 15px;
		}

		.static-content {
			padding: 1.5rem 1.5rem 2rem;
		}

		.static-intro {
			font-size: 18px;
		}

		.static-section p,
		.static-section li {
			font-size: 18px;
		}

		.static-heading {
			font-size: 23px;
		}

		.static-tagline {
			font-size: 15px;
		}

		.static-tagline strong {
			font-size: 19px;
		}
	}

	@media (max-width: 600px) {
		.page-header {
			padding: 1.2rem 1rem 0.8rem;
		}

		.page-title {
			font-size: 28px;
		}

		.page-eyebrow {
			font-size: 10px;
		}

		.page-sub {
			font-size: 14px;
		}

		.static-content {
			padding: 1.2rem 1rem 1.5rem;
		}

		.static-intro {
			font-size: 18px;
		}

		.static-section p,
		.static-section li {
			font-size: 18px;
		}

		.static-heading {
			font-size: 21px;
		}

		.static-footer {
			margin-top: 3rem;
		}
	}

	@media (max-width: 400px) {
		.page-title {
			font-size: 24px;
		}

		.static-content {
			padding: 1rem 0.8rem 1.2rem;
		}

		.static-intro {
			font-size: 18px;
		}

		.static-section p,
		.static-section li {
			font-size: 18px;
		}

		.static-heading {
			font-size: 19px;
		}

		.static-tagline {
			font-size: 14px;
		}

		.static-tagline strong {
			font-size: 17px;
		}
	}
</style>
