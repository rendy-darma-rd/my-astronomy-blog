    </article>
  ) : null}

  <!-- MORE ARTICLES -->
  <div class="section-label">
    <span class="section-label-text">More articles</span>
    <div class="section-label-line"></div>
  </div>

  <div class="cards-grid">
    {cards.map(post => {
      const t = resolveTag(post.data);
      return (
        <article class="card">
          <div class="card-thumb">
            {post.data.heroImage ? (
              <img src={post.data.heroImage.src ?? post.data.heroImage} alt={post.data.title} />
            ) : (
              <div style="width:100%;height:90px;background:#e8e4dc"></div>
            )}
          </div>
          <div class="card-body">
            <div class="card-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></div>
            <div class="card-excerpt">{post.data.description}</div>
            <div class="card-meta">
              <span class={`tag-pill ${t.class}`} style="padding:2px 8px;font-size:10px;">{t.emoji ? t.emoji + ' ' : ''}{t.label}</span>
              <span>{post.data.pubDate.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</span>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- FUN FACT -->
  <div class="fun-fact">
    <div class="fun-fact-icon">💡</div>
    <div>
      <div class="fun-fact-label">Did you know?</div>
      <div class="fun-fact-text">Light from the Sun takes about 8 minutes to reach Earth. So when you look at the Sun (safely!), you're actually seeing it as it was 8 minutes ago.</div>
    </div>
  </div>

  <!-- NEWSLETTER -->
  <div class="newsletter">
    <span class="newsletter-emoji">📬</span>
    <div class="newsletter-title">Get a new cosmic story every week</div>
    <div class="newsletter-sub">No jargon, no overwhelm — just one friendly astronomy story, delivered to your inbox.</div>
    <div class="input-row">
      <input class="email-input" type="email" placeholder="your@email.com"/>
      <button class="sub-btn">Subscribe</button>
