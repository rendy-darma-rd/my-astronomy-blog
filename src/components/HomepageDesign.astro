    <h1 class="hero-title">Looking up at the sky<br>with <span>curiosity and joy</span></h1>
    <p class="hero-desc">Menyajikan beragam artikel astronomi yang menarik dan mudah dipahami untuk semua kalangan.</p>
    <p class="hero-desc hero-desc-long">Setiap artikel ditulis berdasarkan penelitian ilmiah yang dipublikasikan oleh para astronom dari berbagai belahan dunia, sehingga pembaca dapat menjelajahi alam semesta melalui sains yang akurat dan terpercaya.</p>
    <div class="filter-row">
      <a href="/artikel?topic=benda-kecil" class="filter-pill">Benda Kecil</a>
      <a href="/artikel?topic=planet" class="filter-pill">Planet</a>
      <a href="/artikel?topic=bintang" class="filter-pill">Bintang</a>
      <a href="/artikel?topic=gugus-bintang" class="filter-pill">Gugus Bintang</a>
      <a href="/artikel?topic=galaksi" class="filter-pill">Galaksi</a>
      <a href="/artikel?topic=alam-semesta" class="filter-pill">Alam Semesta</a>
      <a href="/artikel?topic=misi-antariksa" class="filter-pill">Misi Antariksa</a>
      <a href="/artikel?topic=sejarah" class="filter-pill">Sejarah</a>
    </div>
  </div>

  <!-- FEATURED -->
  <div class="section-label">
    <span class="section-label-text">HIGHLIGHT</span>
    <div class="section-label-line"></div>
  </div>

  {featured ? (
    <article class="featured">
      <div class="featured-visual">
        {getImageSrc(featured) ? (
          <Image 
            src={getImageSrc(featured)!} 
            alt={featured.data.title}
            width={1200}
            height={675}
            quality={90}
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
          />
        ) : (
          <svg viewBox="0 0 560 200" preserveAspectRatio="xMidYMid slice">
            <rect width="560" height="200" fill="#e8e4dc"/>
            <circle cx="280" cy="100" r="100" fill="#d8d0c0" opacity="0.5"/>
            <circle cx="280" cy="100" r="60"  fill="#ccc4b0" opacity="0.4"/>
            <circle cx="280" cy="100" r="42"  fill="#d4c090"/>
            <ellipse cx="280" cy="95"  rx="40" ry="8" fill="#c8b080" opacity="0.5"/>
            <ellipse cx="280" cy="108" rx="38" ry="6" fill="#c0a870" opacity="0.4"/>
            <ellipse cx="280" cy="100" rx="90" ry="14" fill="none" stroke="#a09060" stroke-width="2.5" opacity="0.7"/>
            <ellipse cx="280" cy="100" rx="70" ry="10" fill="none" stroke="#b8a070" stroke-width="1.5" opacity="0.5"/>
            <circle cx="400" cy="80" r="7" fill="#d8d0c0"/>
          </svg>
        )}
      </div>
      <div class="featured-body">
        {featuredTag ? (
          <span class={`tag-pill ${featuredTag.class}`}>{featuredTag.label}</span>
        ) : null}
        <div class="featured-title"><a href={`/artikel/${featured.id}`}>{featured.data.title}</a></div>
        <div class="featured-excerpt">{truncateText(featured.data.description, 150)}</div>
        <div class="article-meta">
          <span>{featured.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          <a class="read-link" href={`/artikel/${featured.id}`}>Baca artikel →</a>
        </div>
      </div>
    </article>
  ) : null}

  <!-- MORE ARTICLES -->
  <div class="section-label">
    <span class="section-label-text">Artikel Terbaru</span>
    <div class="section-label-line"></div>
    <a href="/artikel" class="view-all-btn">Lihat Semua</a>
  </div>

  <div class="cards-grid">
    {cards.map(post => {
      const t = resolveTag(post.data);
      const imgSrc = getImageSrc(post);
      return (
        <article class="card">
          <div class="card-thumb">
            {imgSrc ? (
              <Image 
                src={imgSrc} 
                alt={post.data.title}
                width={600}
                height={300}
                quality={90}
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            ) : (
              <div style="width:100%;height:90px;background:#e8e4dc"></div>
            )}
          </div>
          <div class="card-body">
            <div class="card-title"><a href={`/artikel/${post.id}`}>{post.data.title}</a></div>
            <div class="card-excerpt">{truncateText(post.data.description, 85)}</div>
            <div class="card-meta">
              <span class={`tag-pill ${t.class}`} style="padding:2px 8px;font-size:10px;">{t.label}</span>
              <span class="card-date">{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <a href={`/artikel/${post.id}`} class="card-read-link">Baca artikel →</a>
          </div>
        </article>
      );
    })}
  </div>

  <!-- FUN FACT SLIDER -->
  <div class="fun-fact-slider-wrapper">
    <button class="slider-nav slider-prev" aria-label="Previous fact">‹</button>
    
    <div class="fun-fact-slider">
      <div class="fun-fact-track">
        <!-- Fact 1 -->
        <div class="fun-fact active">
          <div class="fun-fact-icon">💡</div>
          <div>
            <div class="fun-fact-label">Tahukah Kamu?</div>
            <div class="fun-fact-text">Cahaya dari Matahari butuh sekitar 8 menit untuk sampai ke Bumi. Jadi saat kamu melihat Matahari (dengan aman!), kamu sebenarnya sedang melihatnya seperti 8 menit yang lalu.</div>
          </div>
        </div>

        <!-- Fact 2 -->
        <div class="fun-fact">
          <div class="fun-fact-icon">💡</div>
          <div>
            <div class="fun-fact-label">Tahukah Kamu?</div>
            <div class="fun-fact-text">Galaksi Bima Sakti kita berisi sekitar 200-400 miliar bintang. Namun, kita hanya bisa melihat sekitar 5.000 bintang dengan mata telanjang dari Bumi!</div>
          </div>
        </div>

        <!-- Fact 3 -->
        <div class="fun-fact">
          <div class="fun-fact-icon">💡</div>
          <div>
            <div class="fun-fact-label">Tahukah Kamu?</div>
            <div class="fun-fact-text">Saturnus memiliki kerapatan yang sangat rendah. Jika ada lautan yang cukup besar, planet ini bisa mengapung di atasnya!</div>
          </div>
        </div>

        <!-- Fact 4 -->
        <div class="fun-fact">
          <div class="fun-fact-icon">💡</div>
          <div>
            <div class="fun-fact-label">Tahukah Kamu?</div>
            <div class="fun-fact-text">Satu hari di Venus (243 hari Bumi) lebih lama daripada satu tahun di Venus (225 hari Bumi). Venus juga berotasi ke arah yang berlawanan dengan planet lain!</div>
          </div>
        </div>

        <!-- Fact 5 -->
        <div class="fun-fact">
          <div class="fun-fact-icon">💡</div>
          <div>
            <div class="fun-fact-label">Tahukah Kamu?</div>
            <div class="fun-fact-text">Lubang hitam tidak benar-benar hitam! Mereka memancarkan radiasi yang disebut radiasi Hawking, meskipun sangat lemah.</div>
          </div>
        </div>
      </div>
    </div>

    <button class="slider-nav slider-next" aria-label="Next fact">›</button>
  </div>

  </main>

  <!-- FOOTER -->
  <div class="footer">
    <div class="footer-text">© 2026 Antariksa · Made with curiosity and joy ✨</div>
  </div>

  <BackToTop />

</div>

<script>
  // Hamburger menu toggle
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navLinks?.classList.toggle('active');
  });
  
  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav')) {
      hamburger?.classList.remove('active');
      navLinks?.classList.remove('active');
    }
  });

  // Filter pills
  document.querySelectorAll('.filter-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      const el = e.currentTarget;
      if (el && 'classList' in el) {
        (el as Element).classList.add('active');
      }
    });
  });

  // Fun Fact Slider
  let currentSlide = 0;
  let autoSlideInterval: ReturnType<typeof setInterval>;
  
  const slides = document.querySelectorAll('.fun-fact-track .fun-fact');
  const prevBtn = document.querySelector('.slider-prev');
  const nextBtn = document.querySelector('.slider-next');
  const sliderWrapper = document.querySelector('.fun-fact-slider-wrapper');
  const slider = document.querySelector('.fun-fact-slider');
  
  function goToSlide(n: number) {
    slides[currentSlide].classList.remove('active');
    currentSlide = (n + slides.length) % slides.length;
    slides[currentSlide].classList.add('active');
    resetAutoSlide();
  }
  
  function nextSlide() {
    goToSlide(currentSlide + 1);
  }
  
  function prevSlide() {
    goToSlide(currentSlide - 1);
  }
  
  function resetAutoSlide() {
    clearInterval(autoSlideInterval);
    autoSlideInterval = setInterval(nextSlide, 5000);
  }
  
  // Button event listeners
  prevBtn?.addEventListener('click', prevSlide);
  nextBtn?.addEventListener('click', nextSlide);
  
  // Drag/Swipe functionality
  let isDragging = false;
  let startX = 0;
  let currentX = 0;
  
  function handleDragStart(e: MouseEvent | TouchEvent) {
    isDragging = true;
    startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
    clearInterval(autoSlideInterval);
  }
  
  function handleDragMove(e: MouseEvent | TouchEvent) {
    if (!isDragging) return;
    currentX = 'touches' in e ? e.touches[0].clientX : e.clientX;
  }
  
  function handleDragEnd() {
    if (!isDragging) return;
    isDragging = false;
    
    const diff = startX - currentX;
    const threshold = 50; // minimum drag distance
    
    if (Math.abs(diff) > threshold) {
      if (diff > 0) {
        nextSlide();
      } else {
        prevSlide();
      }
    } else {
      resetAutoSlide();
    }
  }
  
  // Mouse events
  slider?.addEventListener('mousedown', handleDragStart);
  slider?.addEventListener('mousemove', handleDragMove);
  slider?.addEventListener('mouseup', handleDragEnd);
  slider?.addEventListener('mouseleave', handleDragEnd);
  
  // Touch events
  slider?.addEventListener('touchstart', handleDragStart);
  slider?.addEventListener('touchmove', handleDragMove);
  slider?.addEventListener('touchend', handleDragEnd);
  
  // Start auto-sliding
  resetAutoSlide();
  
  // Pause on hover
  sliderWrapper?.addEventListener('mouseenter', () => clearInterval(autoSlideInterval));
  sliderWrapper?.addEventListener('mouseleave', resetAutoSlide);
</script>

<style>
  .logo {
    font-family: 'Lora', serif;
    font-size: 28px;
    color: #3a3a3a;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    z-index: 11;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    background: #e8e0d0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    border: 1.5px solid #d4c9b5;
  }

  .logo-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    gap: 2.2rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'Nunito', sans-serif;
    font-size: 20px;
    color: #4a4034;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #4a6fa5;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 11;
  }

  .hamburger span {
    display: block;
    width: 25px;
    height: 3px;
    background: #4a4034;
    border-radius: 3px;
    transition: all 0.3s;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 60px;
      right: 0;
      transform: translateX(100%);
      flex-direction: column;
      background: rgba(245, 243, 239, 0.98);
      backdrop-filter: blur(10px);
      padding: 2.5rem;
      gap: 2rem;
      border-radius: 14px 0 0 14px;
      border: 1px solid #e2ddd6;
      border-right: none;
      box-shadow: -4px 4px 20px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
      width: 350px;
      max-width: 85vw;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-links a {
      font-size: 20px;
      padding: 0.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .nav-links {
      width: 100vw;
      max-width: 100vw;
      border-radius: 0;
      border-left: none;
      padding: 3rem 2rem;
      gap: 2.5rem;
    }

    .nav-links a {
      font-size: 22px;
    }
  }

  /* Fun Fact Slider Styles */
  .fun-fact-slider-wrapper {
    position: relative;
    z-index: 5;
    margin: 0 2rem 1.5rem;
    text-align: left;
  }

  .fun-fact-slider {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #e8f0f8;
    border: 1px solid #c8d8ec;
    text-align: left;
    cursor: grab;
    user-select: none;
  }

  .fun-fact-slider:active {
    cursor: grabbing;
  }

  .fun-fact-track {
    display: flex;
    position: relative;
    width: 100%;
    text-align: left;
  }

  .fun-fact-track .fun-fact {
    min-width: 100%;
