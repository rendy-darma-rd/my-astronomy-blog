
---
import { Image } from 'astro:assets';

const { getCollection } = await import('astro:content');
const posts = await getCollection('blog');

const TAG_MAP = {
  'benda-kecil': { label: 'Benda Kecil', class: 'tag-benda-kecil' },
  'planet': { label: 'Planet', class: 'tag-planet' },
  'bintang': { label: 'Bintang', class: 'tag-bintang' },
  'gugus-bintang': { label: 'Gugus Bintang', class: 'tag-gugus-bintang' },
  'galaksi': { label: 'Galaksi', class: 'tag-galaksi' },
  'alam-semesta': { label: 'Alam Semesta', class: 'tag-alam-semesta' },
  'misi-antariksa': { label: 'Misi Antariksa', class: 'tag-misi-antariksa' },
  'sejarah': { label: 'Sejarah', class: 'tag-sejarah' },
};

function resolveTag(data: any) {
  // Use the topic field if available
  if (data?.topic) {
    const topic = data.topic.toLowerCase();
    const keys = Object.keys(TAG_MAP) as Array<keyof typeof TAG_MAP>;
    for (const k of keys) {
      if (topic === k) return TAG_MAP[k];
    }
  }
  
  // Fallback: try to resolve from category or tags
  const raw = (data?.category || (data?.tags && data.tags[0]) || '').toString().toLowerCase();
  if (raw) {
    const keys = Object.keys(TAG_MAP) as Array<keyof typeof TAG_MAP>;
    for (const k of keys) {
      if (raw.includes(k)) return TAG_MAP[k];
    }
    // fallback: capitalize first word
    const label = raw.split(/[-_\s]+/).map((s: string) => s[0]?.toUpperCase() + s.slice(1)).join(' ');
    return { label, class: 'tag-deepsky' };
  }
  
  // Default fallback
  return { label: 'Article', class: 'tag-deepsky' };
}

// sort newest first
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const featured = sortedPosts[0];
const cards = sortedPosts.slice(1, 5);
const featuredTag = featured ? resolveTag(featured.data) : null;

// Import all images from content/blog directory
const images = import.meta.glob<{ default: ImageMetadata }>('/src/content/blog/**/*.{jpg,jpeg,png,gif,webp}', { eager: true });

function getImageSrc(post: any) {
  const heroImage = post.data.heroImage;
  if (!heroImage) return null;
  
  // If it's a string, look up the image from the glob imports
  if (typeof heroImage === 'string') {
    // The post.id is like "mengapa-langit-malam-begitu-gelap.mdoc"
    // We need to extract the directory name (without .mdoc extension)
    const postIdWithoutExt = post.id.replace(/\.(mdoc|md|mdx)$/, '');
    
    // Try with the post directory
    const imagePath = `/src/content/blog/${postIdWithoutExt}/${heroImage}`;
    const imageModule = images[imagePath];
    if (imageModule && imageModule.default) {
      return imageModule.default;
    }
    
    // Try without directory (fallback)
    const fallbackPath = `/src/content/blog/${heroImage}`;
    const fallbackModule = images[fallbackPath];
    if (fallbackModule && fallbackModule.default) {
      return fallbackModule.default;
    }
  }
  
  return null;
}

// Helper function to truncate text to max 120 characters
function truncateText(text: string, maxLength: number = 120): string {
  if (!text) return '';
  if (text.length <= maxLength) return text;
  return text.slice(0, maxLength) + '...';
}
---
<div class="blog">

  <!-- NAV -->
  <nav class="nav">
    <a href="/" class="logo">
      <div class="logo-icon">🔭</div>
      <span>Stellara</span>
    </a>
    
    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <ul class="nav-links" id="nav-links">
      <li><a href="/artikel">Artikel</a></li>
      <li><a href="/about">Tentang Kami</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-badge">🌟 Your friendly guide to the universe</div>
    <h1 class="hero-title">Looking up at the sky<br>with <span>curiosity and joy</span></h1>
    <p class="hero-desc">Tulisan-tulisan astronomi yang ditulis dengan sederhana dan hangat — untuk semua pembaca beragam usia yang pernah bertanya-tanya tentang apa yang ada di luar sana.</p>
    <div class="filter-row">
      <a href="/artikel?topic=benda-kecil" class="filter-pill">Benda Kecil</a>
      <a href="/artikel?topic=planet" class="filter-pill">Planet</a>
      <a href="/artikel?topic=bintang" class="filter-pill">Bintang</a>
      <a href="/artikel?topic=gugus-bintang" class="filter-pill">Gugus Bintang</a>
      <a href="/artikel?topic=galaksi" class="filter-pill">Galaksi</a>
      <a href="/artikel?topic=alam-semesta" class="filter-pill">Alam Semesta</a>
      <a href="/artikel?topic=misi-antariksa" class="filter-pill">Misi Antariksa</a>
      <a href="/artikel?topic=sejarah" class="filter-pill">Sejarah</a>
    </div>
  </div>

  <!-- FEATURED -->
  <div class="section-label">
    <span class="section-label-text">HIGHLIGHT</span>
    <div class="section-label-line"></div>
  </div>

  {featured ? (
    <article class="featured">
      <div class="featured-visual">
        {getImageSrc(featured) ? (
          <Image 
            src={getImageSrc(featured)!} 
            alt={featured.data.title}
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
          />
        ) : (
          <svg viewBox="0 0 560 200" preserveAspectRatio="xMidYMid slice">
            <rect width="560" height="200" fill="#e8e4dc"/>
            <circle cx="280" cy="100" r="100" fill="#d8d0c0" opacity="0.5"/>
            <circle cx="280" cy="100" r="60"  fill="#ccc4b0" opacity="0.4"/>
            <circle cx="280" cy="100" r="42"  fill="#d4c090"/>
            <ellipse cx="280" cy="95"  rx="40" ry="8" fill="#c8b080" opacity="0.5"/>
            <ellipse cx="280" cy="108" rx="38" ry="6" fill="#c0a870" opacity="0.4"/>
            <ellipse cx="280" cy="100" rx="90" ry="14" fill="none" stroke="#a09060" stroke-width="2.5" opacity="0.7"/>
            <ellipse cx="280" cy="100" rx="70" ry="10" fill="none" stroke="#b8a070" stroke-width="1.5" opacity="0.5"/>
            <circle cx="400" cy="80" r="7" fill="#d8d0c0"/>
          </svg>
        )}
      </div>
      <div class="featured-body">
        {featuredTag ? (
          <span class={`tag-pill ${featuredTag.class}`}>{featuredTag.label}</span>
        ) : null}
        <div class="featured-title"><a href={`/blog/${featured.id}`}>{featured.data.title}</a></div>
        <div class="featured-excerpt">{truncateText(featured.data.description, 150)}</div>
        <div class="article-meta">
          <span>{featured.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          <a class="read-link" href={`/blog/${featured.id}`}>Baca artikel →</a>
        </div>
      </div>
    </article>
  ) : null}

  <!-- MORE ARTICLES -->
  <div class="section-label">
    <span class="section-label-text">Artikel Terbaru</span>
    <div class="section-label-line"></div>
    <a href="/artikel" class="view-all-btn">Lihat Semua</a>
  </div>

  <div class="cards-grid">
    {cards.map(post => {
      const t = resolveTag(post.data);
      const imgSrc = getImageSrc(post);
      return (
        <article class="card">
          <div class="card-thumb">
            {imgSrc ? (
              <Image 
                src={imgSrc} 
                alt={post.data.title}
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            ) : (
              <div style="width:100%;height:90px;background:#e8e4dc"></div>
            )}
          </div>
          <div class="card-body">
            <div class="card-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></div>
            <div class="card-excerpt">{truncateText(post.data.description, 85)}</div>
            <div class="card-meta">
              <span class={`tag-pill ${t.class}`} style="padding:2px 8px;font-size:10px;">{t.label}</span>
              <span class="card-date">{post.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <a href={`/blog/${post.id}`} class="card-read-link">Baca artikel →</a>
          </div>
        </article>
      );
    })}
  </div>

  <!-- FUN FACT -->
  <div class="fun-fact">
    <div class="fun-fact-icon">💡</div>
    <div>
      <div class="fun-fact-label">Tahukah Kamu?</div>
      <div class="fun-fact-text">Cahaya dari Matahari butuh sekitar 8 menit untuk sampai ke Bumi. Jadi saat kamu melihat Matahari (dengan aman!), kamu sebenarnya sedang melihatnya seperti 8 menit yang lalu.</div>
    </div>
  </div>

  <!-- NEWSLETTER -->
  <!--<div class="newsletter">
    <span class="newsletter-emoji">📬</span>
    <div class="newsletter-title">Get a new cosmic story every week</div>
    <div class="newsletter-sub">No jargon, no overwhelm — just one friendly astronomy story, delivered to your inbox.</div>
    <div class="input-row">
      <input class="email-input" type="email" placeholder="your@email.com"/>
      <button class="sub-btn">Subscribe</button>
    </div>
  </div>-->

  <!-- FOOTER -->
  <div class="footer">
    <div class="footer-text">© 2026 Stellara · Made with curiosity ✨</div>
    <!--<div class="footer-links">
      <a href="#">Twitter</a>
      <a href="#">RSS</a>
      <a href="#">Contact</a>
    </div> -->
  </div>

</div>

<script>
  // Hamburger menu toggle
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    navLinks?.classList.toggle('active');
  });
  
  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav')) {
      hamburger?.classList.remove('active');
      navLinks?.classList.remove('active');
    }
  });

  // Filter pills
  document.querySelectorAll('.filter-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      const el = e.currentTarget;
      if (el && 'classList' in el) {
        (el as Element).classList.add('active');
      }
    });
  });
</script>

<style>
  .logo {
    font-family: 'Lora', serif;
    font-size: 28px;
    color: #3a3a3a;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    z-index: 11;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    background: #e8e0d0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    border: 1.5px solid #d4c9b5;
  }

  .nav-links {
    display: flex;
    gap: 2.2rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'Nunito', sans-serif;
    font-size: 20px;
    color: #7a7060;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #4a6fa5;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 11;
  }

  .hamburger span {
    display: block;
    width: 25px;
    height: 3px;
    background: #7a7060;
    border-radius: 3px;
    transition: all 0.3s;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 60px;
      right: 0;
      transform: translateX(100%);
      flex-direction: column;
      background: rgba(245, 243, 239, 0.98);
      backdrop-filter: blur(10px);
      padding: 2.5rem;
      gap: 2rem;
      border-radius: 14px 0 0 14px;
      border: 1px solid #e2ddd6;
      border-right: none;
      box-shadow: -4px 4px 20px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
      width: 350px;
      max-width: 85vw;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-links a {
      font-size: 20px;
      padding: 0.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .nav-links {
      width: 100vw;
      max-width: 100vw;
      border-radius: 0;
      border-left: none;
      padding: 3rem 2rem;
      gap: 2.5rem;
    }

    .nav-links a {
      font-size: 22px;
    }
  }
</style>
