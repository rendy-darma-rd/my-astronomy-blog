            <ellipse cx="280" cy="100" rx="70" ry="10" fill="none" stroke="#b8a070" stroke-width="1.5" opacity="0.5"/>
            <circle cx="400" cy="80" r="7" fill="#d8d0c0"/>
          </svg>
        )}
      </div>
      <div class="featured-body">
        {featuredTag ? (
          <span class={`tag-pill ${featuredTag.class}`}>{featuredTag.emoji ? featuredTag.emoji + ' ' : ''}{featuredTag.label}</span>
        ) : null}
        <div class="featured-title"><a href={`/blog/${featured.id}`}>{featured.data.title}</a></div>
        <div class="featured-excerpt">{featured.data.description}</div>
        <div class="article-meta">
          <span>{featured.data.pubDate.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          <a class="read-link" href={`/blog/${featured.id}`}>Read article →</a>
        </div>
