    flex-shrink: 0;
    padding: 1.2rem 1.4rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
    border: none;
    border-radius: 0;
    background: transparent;
    margin: 0;
    box-sizing: border-box;
  }

  .fun-fact-track .fun-fact > div {
    min-width: 0;
  }

