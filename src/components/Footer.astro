---
const today = new Date();
const currentPath = Astro.url.pathname;

const navLinks = [
	{ href: '/artikel', label: 'Artikel' },
	{ href: '/about', label: 'Tentang Kami' },
	{ href: '/contact', label: 'Kontak' },
	{ href: '/privacy-policy', label: 'Kebijakan Privasi' },
	{ href: '/sitemap', label: 'Peta Situs' },
];
---

<footer class="site-footer">
	<div class="footer-top">
		<a href="/" class="footer-logo">
			<img src="/logo.svg" alt="Antariksa" class="footer-logo-image" />
			<span>Antariksa</span>
		</a>

		<nav class="footer-nav" aria-label="Navigasi footer">
			<ul>
				{navLinks.map((link) => (
					<li><a href={link.href} class={currentPath === link.href ? 'active' : ''}>{link.label}</a></li>
				))}
			</ul>
		</nav>
	</div>

	<div class="footer-bottom">
		<div class="footer-text">© {today.getFullYear()} Antariksa · Made with curiosity and joy ✨</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 5;
		border-top: 1px solid #e2ddd6;
		background: #eceae4;
		font-family: 'Nunito', sans-serif;
	}

	.footer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 1.5rem 2rem;
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: 'Lora', serif;
		font-size: 22px;
		color: #3a3a3a;
		text-decoration: none;
	}

	.footer-logo-image {
		width: 32px;
		height: 32px;
		object-fit: contain;
	}

	.footer-nav ul {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
	}

	.footer-nav a {
		font-size: 15px;
		color: #6e5f52;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-nav a:hover,
	.footer-nav a.active {
		color: #4a6fa5;
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem 2rem;
		border-top: 1px solid #e2ddd6;
	}

	.footer-text {
		font-size: 14px;
		color: #6e5f52;
		font-family: 'Nunito', sans-serif;
	}

	@media (max-width: 768px) {
		.footer-top {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1.5rem 1rem;
		}

		.footer-nav ul {
			justify-content: center;
			gap: 1rem 1.5rem;
		}
	}
</style>
