---
const today = new Date();
---

<div class="footer">
	<div class="footer-text">© {today.getFullYear()} Antariksa · Made with curiosity and joy ✨</div>
</div>

<style>
	.footer {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 2rem;
		border-top: 1px solid #e2ddd6;
		background: #eceae4;
		font-family: 'Nunito', sans-serif;
	}
	
	.footer-text {
		font-size: 14px;
		color: #6e5f52;
		font-family: 'Nunito', sans-serif;
	}
</style>
